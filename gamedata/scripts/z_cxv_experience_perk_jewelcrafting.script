gc = game.translate_string

function try_spawn_jewelry_loot(obj, bag, mode)
    if obj and bag == "actor_bag" and mode == "inventory" and x_cxv_perks_data.perks["perk_jewelcrafter"] > 0 then
		if obj:section() == "jewelry_box" then
			return gc("st_perk_jewelcrafting_box_open_tip")
		end
    end
end

local DEBUG_TESTING_MONEY_DROP = false
local rand = math.random
local box_min_tbl = {[1] = 1, [2] = 1, [3] = 2, [4] = 2, [5] = 3}
local box_max_tbl = {[1] = 3, [2] = 4, [3] = 5, [4] = 6, [5] = 7}
function jewelry_box_opening(obj, bag, mode)
	if not obj or bag ~= "actor_bag" or mode ~= "inventory" or x_cxv_perks_data.perks["perk_jewelcrafter"] <= 0 then return end
	local adj_perk_lvl = clamp(x_cxv_perks_data.perks["perk_jewelcrafter"], 1, 5)
	local spawn_cnt = rand(box_min_tbl[adj_perk_lvl], box_max_tbl[adj_perk_lvl])
	
	local tr_list = experience_traits and experience_traits.spawn_trait_list
	local tr_cnt = (tr_list and #tr_list) or nil
	
	for i=1, spawn_cnt do
		if tr_list and (not DEBUG_TESTING_MONEY_DROP) then
			sec = tr_list[rand(1, tr_cnt)]
			if ini_sys:section_exist(sec) then
				alife_create_item(sec, db.actor)
			end
		else
			-- failsafe: give some cash
			local cash_roll = rand(1,30)
			alife_create_item(	(cash_roll < 11 and "money_10_50") or 
								((cash_roll >= 11 and cash_roll < 21) and "money_100_200") or 
								((cash_roll >= 21 and cash_roll < 26) and "money_300_400") or 
								((cash_roll >= 26 and cash_roll < 30) and "money_600_700") or 
								(cash_roll == 30 and "money_900_1000"),
			db.actor)
		end
	end
	alife_release(obj)
end

function on_game_start()
	custom_functor_autoinject.add_functor("perk_jewelcrafter_jewelery_box", try_spawn_jewelry_loot, try_spawn_jewelry_loot, nil, jewelry_box_opening, true)
end

if experience_traits then

	local jewelcrafter_bonus = {[0] = 0, [1] = 3, [2] = 5, [3] = 8, [4] = 10, [5] = 15}
	
	experience_traits.UIExperienceTraits.UpdateUpgradeChance = function(self)
		local tr_manager = experience_traits.get_traits_manager()
		local tr = tr_manager:trait_by_id(self.selected.id)
		local max_level = tr:max_level()
		local qual = tr:quality() - (self.upgr_mode.quality - 1)
		local curr_level = tr:level() - self.upgr_mode.curr_level
		
		-- TEST: Grant a bonus to base chance if both gems are the same (20% bonus)
		local are_same_family = tr:section() == self.upgr_mode.sec
		
		local base_chance = 99
		if qual > 0 then
			base_chance = base_chance / qual
		elseif qual < 0 then
			base_chance = base_chance + base_chance / (self.max_qual_lvl + qual)
		end
		
		if are_same_family then
			base_chance = base_chance * 1.2
		end
		
		local result = ( base_chance - base_chance / (max_level / curr_level) ) + jewelcrafter_bonus[x_cxv_perks_data.perks["perk_jewelcrafter"]]
		result = clamp(math.floor(result + 0.5), 1, 100)
	
		local flags = { chance = result }
		SendScriptCallback("experience_on_upgrade_trait_chance", tr:section(), tr:level(), tr:max_level(), tr:quality(), flags)
	
		self.upgr_mode.chance = type(flags.chance) == "number" and clamp(math.floor(flags.chance + 0.5), 1, 100) or result
	end
end