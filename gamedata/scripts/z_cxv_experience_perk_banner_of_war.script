-- Will cache the ID of the enemy killed and keep memory of what faction patch was worn for looting purposes
-- On-hit effects will check "cached_patch_faction" variable directly
-- Add to cache on enemy death in ..._effects.script
-- Keep on save + load while in the same level - clear on changing level
-- Clear during "death_manager.create_release_item()" in looting script + "monster_on_loot_init" function in this script
-- [objID] = "player_patch_faction"
local death_id_patch_cache = {}

function store_killed_enemy_paired_patch(obj)
	if not obj then return end
	if not cached_patch_faction then return end
	
	death_id_patch_cache[obj:id()] = cached_patch_faction
end

function get_killed_enemy_paired_patch(obj)
	if not obj then return end
	
	printf("[RPG - Banner of War] Getting killed enemy paired-patch (%s)...", death_id_patch_cache[obj:id()])
	
	return death_id_patch_cache[obj:id()] or ""
end

function clear_killed_enemy_paired_patch(obj)
	if not obj then return end
	
	printf("[RPG - Banner of War] Clearing killed enemy paired-patch (%s)...", death_id_patch_cache[obj:id()])

	death_id_patch_cache[obj:id()] = nil
	
end

