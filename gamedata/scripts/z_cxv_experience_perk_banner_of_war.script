-- Workhorse script to find and cache patch variable on currently equipped armor
-- "nil" --> perk not invested in
-- "neutral" --> perk IS invested in outfit does not fit a patch on it

local random = math.random
local gt = game.translate_string
local strformat = string.format

cached_patch_faction = nil
cached_outfit_id = nil
local last_banner_level = 0

local actor = nil
local function get_actor()
	if actor ~= nil then
		return actor
	else
		actor = db.actor
		return actor
	end
end

