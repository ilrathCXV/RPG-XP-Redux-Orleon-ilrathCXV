-- TODO: Add message showing Roubles gained
-- Note to self: Ensure to check if object being passed as "stalker" pass "IsStalker()" func
local rank_name = ranks.get_obj_rank_name
function renegade_stalker_kill_roubles(stalker)
	if not stalker then return end
	
	local stalker_faction = stalker:character_community()
	
	if (not stalker_faction) then
		stalker_faction = "stalker"
	end
	
	local stalker_rank = ((stalker.character_rank or stalker.rank) and rank_name(stalker)) or "novice"
--	printf("[RPG - Banner of War] RENEGADES - Roubles: %s | Faction: %s | Rank: %s", rouble_amt, stalker_faction, stalker_rank)
	if not renegade_stalker_rank_mult[stalker_rank] then
		stalker_rank = "experienced"
	end
	
	local rouble_amt = math.ceil((renegade_stalker_faction_base[stalker_faction] or 100) * (renegade_stalker_rank_mult[stalker_rank] or 1))
	
	get_actor():give_money(rouble_amt)
	get_actor():give_game_news(gt("cxv_banner_of_war_renegade_title"), strformat( gt("cxv_banner_of_war_renegade"), rouble_amt ), news_manager.tips_icons["renegade"], 0, 5000, 0)

end

local get_random_enemy_faction = game_relations.get_random_enemy_faction
local get_random_natural_faction = game_relations.get_random_natural_faction

function killer_patch_generation(obj)
	if obj then 
		local stalker_faction
		
		-- checking if stash - set it to actor's faction to locate a patch
		if IsInvbox(obj) then
			stalker_faction = character_community(get_actor()):sub(7)
		else
			stalker_faction = obj:character_community()
		end
		
		if (stalker_faction and stalker_faction == "greh_npc" or stalker_faction == "zombied") or (not stalker_faction) then
			stalker_faction = "stalker"
		end
		
--		printf("[RPG - Banner of War] MERCENARY - Enemy faction: %s", stalker_faction)
		
		-- Get random enemy faction, then try friendly/neutral faction next, then default to Loner
		local enemy_or_natural = random(2)
		local random_faction = nil
		if enemy_or_natural == 1 then	-- enemy
			random_faction = get_random_enemy_faction(stalker_faction) or "stalker"
		else							-- natural
			random_faction = get_random_natural_faction(stalker_faction) or "stalker"
		end
		
--		printf("[RPG - Banner of War] MERCENARY - Random faction for patch: %s", random_faction)
		
		local patch_section = random_faction .. "_patch"
--		printf("[RPG - Banner of War] MERCENARY - Patch Selected: %s", patch_section)
		if ini_sys:section_exist(patch_section) then
			return patch_section
		end
	end
	
	return "stalker_patch"
end

-------------------------------------------------------------------------
-------------------------------------------------------------------------

function cache_outfit_patch_section(obj, sec)
	if obj and obj:id() == cached_outfit_id then return end
	
	cached_patch_faction = "neutral"
	cached_outfit_id = nil
	
	if not obj then
		printf("[RPG - Banner of War] No outfit given - outfit patch set as Neutral (%s)", cached_patch_faction)
		return
	end
	local section = sec or obj:section()
	
	cached_patch_faction = ini_sys:r_string_ex(section,"community") or "neutral"
	cached_outfit_id = obj:id()
	
	printf("[RPG - Banner of War] Outfit cached (%s | %s) - outfit patch set as %s", section, cached_outfit_id, cached_patch_faction)
	
end

function actor_item_to_slot(item)
	if not item then return end
	if x_cxv_perks_data.perks["perk_banner_of_war"] < 1 then return end
	if not IsOutfit(item) then return end

	cache_outfit_patch_section(item, item and item:section())
end

function actor_item_to_ruck(item)
	if not item then return end
	if x_cxv_perks_data.perks["perk_banner_of_war"] < 1 then return end
	if not IsOutfit(item) then return end
	if not cached_outfit_id == item:id() then return end
	
	if get_actor() then
		local armor = get_actor():item_in_slot(7)
		cache_outfit_patch_section(armor, armor and armor:section())
	else
		cache_outfit_patch_section(nil, nil)
	end
end

function actor_on_first_update()
	if x_cxv_perks_data.perks["perk_banner_of_war"] < 1 then
		printf("[RPG - Banner of War] Perk not taken - clearing cached outfit faction patch + cached outfit ID")
		cached_patch_faction = nil
		cached_outfit_id = nil
		return
	end
	
	if get_actor() then
		local armor = get_actor():item_in_slot(7)
		cache_outfit_patch_section(armor, armor and armor:section())
	end
end

function skill_on_update(perk_id, perk_data)
	if perk_id == "perk_banner_of_war" and perk_data["curr_level"] ~= last_banner_level then
		printf("[RPG - Banner of War] Perk taken/registered - finding outfit...")
		last_banner_level = perk_data["curr_level"]
		if get_actor() then
			local armor = get_actor():item_in_slot(7)
			cache_outfit_patch_section(armor, armor and armor:section())
		end
	end
end

-- Save/load of killed enemy ID patch cache table while on same level
function save_state(mdata)
	mdata.death_id_patch_cache = death_id_patch_cache
end

function load_state(mdata)
	if mdata.death_id_patch_cache then
		death_id_patch_cache = mdata.death_id_patch_cache
	else
		death_id_patch_cache = {}
	end
end

-- Clear killed enemy ID patch cache table - all corpses will get cleared (eventually)
function on_before_level_changing(...)
	printf("[RPG - Banner of War] Changing level - clearing cached killed enemy paired-patch list...")
	empty_table(death_id_patch_cache)
end

