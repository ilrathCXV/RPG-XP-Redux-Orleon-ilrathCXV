-- TODO: Add message showing Roubles gained
-- Note to self: Ensure to check if object being passed as "stalker" pass "IsStalker()" func
function duty_mutant_kill_roubles(monster)
	
	if not monster then return end
	local section = monster:section()
	
	local rouble_amt = duty_mutant_class_amt[(section == "gigant_jumper" and clsid.pseudo_gigant) or monster:clsid()] 
	or duty_mutant_class_amt[SYS_GetParam(2, section, "kind", "definitely_not_found_kind")] 
	or duty_mutant_class_amt[SYS_GetParam(0, section, "kind", 0)]
	or 200
	
--	printf("[RPG - Banner of War] DUTY - Roubles: %s | Mutant section: %s", rouble_amt, section)
	
	get_actor():give_money(rouble_amt)
--	news_manager.send_tip(get_actor(), strformat( gt("cxv_banner_of_war_dolg", rouble_amt) ), nil, "dolg")
	get_actor():give_game_news(gt("cxv_banner_of_war_dolg_title"), strformat( gt("cxv_banner_of_war_dolg"), rouble_amt ), news_manager.tips_icons["dolg"], 0, 5000, 0)

end

