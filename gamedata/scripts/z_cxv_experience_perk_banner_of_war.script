-----------------------------------------------------------------------------------------------------
-- Perk functionality that can exist within this own script/doesn't need to interact with other scripts' functions

-- Clear Sky: immunity to in-water radiation + bleed restore (placing it here since this is already an "on update" function)
local bleed_restore_per_ms = 0.0000123
local actor_bleed_k = ini_sys:r_float_ex("actor_condition", "bleed_speed_k") or 1
local balance_modifier = 0.60
BaseRadWaterUpdate = gameplay_radioactive_water.actor_on_update
function gameplay_radioactive_water.actor_on_update(_,delta)
	if cached_patch_faction and cached_patch_faction == "csky" then
		if get_actor() then
			get_actor().bleeding = bleed_restore_per_ms * delta * actor_bleed_k * balance_modifier
		end
		return
	end
	BaseRadWaterUpdate(_,delta)
end

-- Ecologist: 15% chance for picking a random piece of mutant loot to duplicate + 0.01% chance to loot a "Bat"
-- Bandit: 5% chance to loot a jewelry box
-- Will call getter() to keep things uniform across scripts
function monster_on_loot_init(monster, loot_table)
	local killed_enemy_paired_patch = get_killed_enemy_paired_patch(monster)
	if killed_enemy_paired_patch == "ecolog" then
		if (random(100) <= 15) then
--			printf("[RPG - Banner of War] ECOLOG - Finding mutant loot to add...")
			local random_loot_key = random_key_table(loot_table)
			if random_loot_key then
--				printf("[RPG - Banner of War] ECOLOG - Loot found to add: %s", random_loot_key)
				loot_table[random_loot_key].count = loot_table[random_loot_key].count + 1
			end
		end
		if (random(1000) == 1) then	-- 0.01% chance roll
--			printf("[RPG - Banner of War] ECOLOG - Bat artefact to be added to mutant loot...")
			if not loot_table["af_bat"] then
				loot_table["af_bat"] = {count = 0}
			end
			
			loot_table["af_bat"].count = loot_table["af_bat"].count + 1
		end
	elseif killed_enemy_paired_patch == "bandit" then
		if (random(100) <= 8) then
--			printf("[RPG - Banner of War] BANDIT - Jewelry Box to be added to mutant loot...")
			if not loot_table["jewelry_box"] then
				loot_table["jewelry_box"] = {count = 0}
			end
			
			loot_table["jewelry_box"].count = loot_table["jewelry_box"].count + 1
		end
	end
	
	clear_killed_enemy_paired_patch(monster)
end

-----------------------------------------------------------------------------------------------------
-----------------------------------------------------------------------------------------------------

function on_game_start()
	if experience_potions then
		RegisterScriptCallback("experience_skill_on_update", experience_skill_on_update)
	else
		RegisterScriptCallback("experience_perk_on_update", experience_skill_on_update)
	end
	
	RegisterScriptCallback("actor_item_to_slot", actor_item_to_slot)
	RegisterScriptCallback("actor_item_to_ruck", actor_item_to_ruck)
	RegisterScriptCallback("actor_on_first_update", actor_on_first_update)
	
	RegisterScriptCallback("monster_on_loot_init", monster_on_loot_init)
	
	RegisterScriptCallback("save_state",save_state)
	RegisterScriptCallback("load_state",load_state)
	RegisterScriptCallback("on_before_level_changing", on_before_level_changing)
	
end


